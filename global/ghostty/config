# Font
font-family = "Source Code Pro",Manoco,monospace
font-size = 18.5

# Appearance
background-blur = 20
background-opacity = 0.8
bold-is-bright = true
cursor-style = bar
theme = Deep
cursor-click-to-move = true

# Window
window-padding-x = 15
window-padding-y = 10
maximize = true

# Keybinds
keybind = cmd+shift+r=reload_config
keybind = shift+enter=text:\n

# Keyboard
# Left Option sends Alt/Meta so alt+* shortcuts work instead of inserting
# glyphs; right Option still composes accented characters (e.g. e -> é).
macos-option-as-alt = left
